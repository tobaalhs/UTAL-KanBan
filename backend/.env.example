# Copiar este archivo como `.env` y completar los valores.
# El archivo `.env` esta en el .gitignore: nunca se sube al repositorio.

# Clave para firmar los tokens JWT (usar un texto largo y aleatorio)
JWT_SECRET=

# --- Correos (Resend: https://resend.com) ---
# API key creada en el panel de Resend
EMAIL_API_KEY=
# Remitente. Sin un dominio verificado en Resend solo se puede usar este
# y los correos unicamente llegan al email con el que se creo la cuenta de Resend.
EMAIL_FROM=Utal KanBan <onboarding@resend.dev>
# URL del frontend: se usa para el boton "Abrir tablero" del correo
APP_URL=http://localhost:5173
